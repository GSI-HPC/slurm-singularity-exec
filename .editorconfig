root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The C sources follow the style of Slurm, which is the Linux kernel style.
[*.{c,h}]
indent_style = tab
indent_size = 8
max_line_length = 80

[{Dockerfile,*.Dockerfile}]
indent_size = 4
